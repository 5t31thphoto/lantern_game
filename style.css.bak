:root{--bg:#061311;--panel:#0c201d;--panel2:#102824;--line:#28463f;--text:#edf3e9;--muted:#9db5ad;--gold:#f0cf82;--green:#8bd8b5;--shadow:0 20px 60px #0008}*{box-sizing:border-box}html,body{margin:0;min-height:100%;background:radial-gradient(circle at 50% 0,#173a35,#071614 48%,#030908);color:var(--text);font:16px/1.5 system-ui,-apple-system,Segoe UI,sans-serif}body{min-height:100vh}.bar{height:64px;display:flex;align-items:center;justify-content:space-between;padding:0 max(18px,calc((100vw - 1100px)/2));position:sticky;top:0;z-index:20;background:#061311e8;border-bottom:1px solid #28463f;backdrop-filter:blur(12px)}.brand{display:flex;gap:9px;align-items:center}.brand strong{font:20px Georgia,serif}.brand span{font-size:10px;letter-spacing:.16em;text-transform:uppercase;color:var(--muted)}#hud{font-size:13px;color:var(--muted)}#hud b{color:var(--gold)}main{max-width:1100px;margin:auto;padding:44px 20px 100px}.hero{display:grid;grid-template-columns:1fr 1fr;gap:28px;align-items:center;min-height:520px}.eyebrow{color:var(--gold);font-weight:800;font-size:11px;letter-spacing:.2em}.hero h1{font:clamp(40px,6vw,70px)/.98 Georgia,serif;margin:10px 0 24px;letter-spacing:-.03em}.lead{font:20px/1.55 Georgia,serif;color:#c8d7d0;max-width:600px}.primary,.secondary,.ghost,.quick button,.choice,.mini button{border:1px solid var(--line);border-radius:15px;padding:13px 18px;background:#102824;color:var(--text);font:inherit;cursor:pointer}.primary{background:linear-gradient(135deg,#cda85e,#f3d78d);color:#17221e;border-color:#f3d78d;font-weight:800}.hero-sky,.scene{border:1px solid var(--line);border-radius:30px;min-height:470px;position:relative;overflow:hidden;background:radial-gradient(circle at 50% 55%,#e8c77b18,transparent 17%),linear-gradient(#07131f,#0a211e 70%,#06100d)}.moon{position:absolute;width:100px;height:100px;border-radius:50%;right:17%;top:13%;background:#e5e9d3;box-shadow:0 0 70px #dfe8c944}.hill{position:absolute;left:-10%;right:-10%;bottom:-80px;height:190px;background:#050e0c;border-radius:50% 50% 0 0}.distant-lights{position:absolute;inset:0;background-image:radial-gradient(circle,#f6d98a 1.5px,transparent 2px);background-size:83px 71px;opacity:.7}.quick{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}.quick button{text-align:left;min-height:105px;transition:.18s}.quick button:hover{transform:translateY(-3px);border-color:#5b7c70}.quick small{display:block;color:var(--muted);margin-top:8px}.notice{margin-top:16px;padding:16px 18px;border:1px solid var(--line);border-radius:16px;background:#0c201dcc;display:flex;gap:15px}.notice b{color:var(--gold)}.screen{display:grid;gap:18px}.panel{border:1px solid var(--line);border-radius:24px;background:#0b1d1ae8;padding:22px;box-shadow:var(--shadow)}.two{display:grid;grid-template-columns:1.15fr .85fr;gap:18px}.scene{min-height:600px}.scene .stars{position:absolute;inset:0;background-image:radial-gradient(circle,#fff1c6aa 1px,transparent 1.5px);background-size:67px 59px}.lantern{position:absolute;left:50%;top:46%;transform:translate(-50%,-50%);width:170px;height:225px}.lantern .body{position:absolute;left:20px;right:20px;top:38px;height:170px;border:5px solid #d6bd78;border-radius:46% 46% 35% 35%;background:radial-gradient(circle at 50% 55%,#ffe79e 0,#a87a3d44 42%,#33291e 100%);box-shadow:0 0 40px #f2cb6b22}.lantern .frame:before,.lantern .frame:after{content:"";position:absolute;top:28px;bottom:12px;width:4px;background:#d6bd78}.lantern .frame:before{left:47px}.lantern .frame:after{right:47px}.lantern .top{position:absolute;left:42px;top:22px;width:86px;height:23px;border:4px solid #d6bd78;border-radius:50%}.lantern .base{position:absolute;left:48px;bottom:7px;width:74px;height:18px;border:4px solid #d6bd78;border-radius:50%}.lantern .flame{position:absolute;left:76px;top:181px;width:19px;height:35px;border-radius:60% 60% 55% 55%;background:#ffe08a;box-shadow:0 0 40px 13px #ffc95b66;opacity:.18}.lantern.lit .flame{opacity:1;animation:flicker .18s infinite alternate}.lantern .message{position:absolute;left:45px;right:45px;top:95px;text-align:center;font:13px Georgia,serif;color:#f8edc8;word-break:break-word}@keyframes flicker{to{transform:scale(.85) translateY(2px)}}.craft{display:grid;grid-template-columns:repeat(5,1fr);gap:8px}.part{padding:12px;border:1px solid var(--line);border-radius:13px;text-align:center;color:var(--muted);cursor:pointer}.part.done{border-color:#5d927e;background:#12352e;color:var(--green)}.part b{display:block;color:var(--text);margin-top:4px}.actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:16px}textarea{width:100%;min-height:120px;border-radius:14px;border:1px solid var(--line);background:#071512;color:var(--text);padding:13px}.choice-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}.choice{text-align:left;min-height:125px}.choice strong,.choice small{display:block}.choice small{color:var(--muted);margin-top:6px}.choice.selected{border-color:var(--gold);box-shadow:0 0 0 2px #f0cf8222}.resource-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.resource{min-height:150px;display:flex;flex-direction:column;justify-content:space-between}.resource h2{margin:0;font:24px Georgia,serif}.resource p{color:var(--muted)}.skyview{min-height:620px;border-radius:26px;position:relative;overflow:hidden;background:linear-gradient(#030a16,#061d1a)}.skyview:before{content:"";position:absolute;inset:0;background-image:radial-gradient(circle,#fff3c9aa 1px,transparent 1.5px);background-size:59px 53px}.skyview .moon{width:90px;height:90px}.sky-lantern{position:absolute;width:12px;height:18px;border-radius:45%;background:#ffd97b;box-shadow:0 0 18px 7px #f0c45a66;animation:drift 5s ease-in-out infinite alternate}.sky-lantern button{all:unset;cursor:pointer;width:100%;height:100%}@keyframes drift{to{transform:translateY(-8px)}}.flight{min-height:700px;position:relative;overflow:hidden;border-radius:28px;background:linear-gradient(#020816,#071b19)}.flight .stars{position:absolute;inset:0;background-image:radial-gradient(circle,#fff4ceaa 1px,transparent 1.5px);background-size:61px 57px}.flight-lantern{position:absolute;left:50%;bottom:16%;transform:translate(-50%,50%);transition:none}.flight.go .flight-lantern{animation:ascend 7s cubic-bezier(.12,.6,.18,1) forwards}@keyframes ascend{0%{bottom:16%;transform:translate(-50%,50%) scale(1)}45%{bottom:65%;transform:translate(-50%,50%) scale(.55)}100%{bottom:115%;transform:translate(-50%,50%) scale(.045);opacity:.08}}.flight-caption{position:absolute;bottom:25px;left:0;right:0;text-align:center;color:#bdccc5}.mini{min-height:360px;position:relative;border:1px solid var(--line);border-radius:22px;overflow:hidden;background:radial-gradient(circle at 50% 50%,#173c35,#061210)}.firefly{position:absolute;border:0;background:none;color:#ffe59a;font-size:35px;text-shadow:0 0 25px #ffd05f;cursor:pointer}.zen{max-width:760px;margin:auto;text-align:center}.orb{height:400px;display:flex;align-items:center;justify-content:center}.orb .lantern{position:relative;left:auto;top:auto;transform:none;animation:zenfloat 7s ease-in-out infinite}.orb .lantern.lit{filter:drop-shadow(0 0 45px #f0c86b77)}@keyframes zenfloat{50%{transform:translateY(-12px)}}.toast{position:fixed;z-index:100;left:50%;bottom:85px;transform:translate(-50%,20px);opacity:0;background:#f0d58e;color:#18231f;padding:12px 17px;border-radius:14px;font-weight:800;transition:.2s;pointer-events:none}.toast.show{opacity:1;transform:translate(-50%,0)}.back{margin-bottom:8px}.muted{color:var(--muted)}@media(max-width:800px){.hero,.two{grid-template-columns:1fr}.hero{min-height:0}.hero-sky{min-height:340px}.quick{grid-template-columns:repeat(2,1fr)}.choice-grid{grid-template-columns:repeat(2,1fr)}.craft{grid-template-columns:repeat(5,1fr);overflow:auto}.resource-grid{grid-template-columns:1fr}.flight{min-height:560px}.hero h1{font-size:42px}}@media(max-width:520px){main{padding:25px 13px 90px}.bar{padding:0 13px}.bar #hud{font-size:11px}.hero-sky{min-height:300px}.quick button{min-height:95px}.choice-grid{grid-template-columns:1fr 1fr}.scene{min-height:540px}.lantern{transform:translate(-50%,-50%) scale(.82)}.flight-lantern{transform:translate(-50%,50%) scale(.8)}}
